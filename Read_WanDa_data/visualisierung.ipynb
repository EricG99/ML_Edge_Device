import pandas as pd
import matplotlib.pyplot as plt
import os

# Laden der Daten

script_dir = os.path.dirname(__file__)
csv_path = os.path.join(script_dir, 'aufzeichnungen', 'mqtt_data_rate_limited.csv')
df = pd.read_csv(csv_path)

# Umwandlung des 'time'-Spalte in Millisekunden und Berechnung der verstrichenen Zeit in Sekunden
df['time'] = pd.to_datetime(df['time'], unit='ms')
start_time = df['time'].iloc[0]
df['elapsed_time_seconds'] = (df['time'] - start_time).dt.total_seconds()

# Umbenennung der Spalten in deutsche Übersetzungen ohne Zahlen
column_mapping = {
    'Group4-2_S6_MassFlowRate': 'Massenflussrate',
    'Group4-2_S6_FlowVelocity': 'Fließgeschwindigkeit',
    'Group4-2_S6_Volume': 'Volumen',
    'Group4-2_S6_VolumetricFlowRate': 'Volumenstrom',
    'Group4-2_S6_Mass': 'Masse',
    'Group4-2_S6_Energy': 'Energie',
    'Group4-2_S6_Temperature': 'Temperatur',
    'Group4-2_S6_Pressure': 'Druck'
}
df = df.rename(columns=column_mapping)

# Erstellung der Liste der deutschen Spaltennamen für die Visualisierung
german_cols = list(column_mapping.values())

# Erstellung des Plots
plt.figure(figsize=(15, 8))
for col in german_cols:
    plt.plot(df['elapsed_time_seconds'], df[col], label=col)

plt.title('Visualisierung der Sensordaten über die Zeit')
plt.xlabel('Verstrichene Zeit (Sekunden)')
plt.ylabel('Werte')
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.savefig('sensordaten_visualisierung.png')