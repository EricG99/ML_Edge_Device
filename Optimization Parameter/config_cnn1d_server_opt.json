{
  "loading_strategy": "split",
  "train_fraction": 0.8,
  "validation_fraction": 0.2,
  "dataset": "C:\\DEV\\RevPi_ML\\ML_Edge_Device\\Input\\Input_Data\\mqtt_data_filtered.csv",
  "target_column": "Group4-2_S6_VolumetricFlowRate",
  "exclude_columns": [
    "time",
    "datetime",
    "recording_timestamp",
    "duration"
  ],
  "lags": 4,
  "horizon": 4,
  "base_features": [
    "Group4-2_S6_VolumetricFlowRate",
    "Group4-2_S6_MassFlowRate"
  ],
  "optimize_on": "server",
  "model_name": "cnn1d_server",
  "feature_engineering": {
    "enable": true,
    "rolling_windows": [
      3,
      5,
      9,
      15
    ],
    "stats": [
      "mean",
      "std"
    ],
    "add_diff": false,
    "add_pct": false,
    "ewm_alphas": []
  },
  "search_space": {
    "cnn_blocks": {
      "type": "int",
      "min": 2,
      "max": 4
    },
    "cnn_base_filters": {
      "type": "int",
      "min": 64,
      "max": 256
    },
    "cnn_kernel_size": {
      "type": "int",
      "min": 3,
      "max": 9
    },
    "cnn_dropout": {
      "type": "float",
      "min": 0.05,
      "max": 0.5
    },
    "cnn_activation": {
      "type": "choice",
      "choices": [
        "relu",
        "gelu"
      ]
    },
    "batch_size": {
      "type": "int_choice",
      "choices": [
        32,
        64,
        96,
        128
      ]
    },
    "epochs": {
      "type": "int",
      "min": 50,
      "max": 150
    },
    "optimizer": {
      "type": "choice",
      "choices": [
        "adam",
        "rmsprop",
        "nadam",
        "adamw"
      ]
    },
    "learning_rate": {
      "type": "log_float",
      "min": 0.0001,
      "max": 0.003
    },
    "clipnorm": {
      "type": "float",
      "min": 0.5,
      "max": 5.0
    },
    "weight_decay": {
      "type": "log_float",
      "min": 1e-06,
      "max": 0.001
    },
    "lags": {
      "type": "int",
      "min": 1,
      "max": 20
    },
    "rolling_window_size": {
      "type": "int",
      "min": 1,
      "max": 20
    }
  }
}