{
  "loading_strategy": "split",
  "train_fraction": 0.8,
  "validation_fraction": 0.2,
  "dataset": "C:\\DEV\\RevPi_ML\\ML_Edge_Device\\Input\\Input_Data\\mqtt_data_filtered.csv",
  "target_column": "Group4-2_S6_VolumetricFlowRate",
  "exclude_columns": [
    "time",
    "datetime",
    "recording_timestamp",
    "duration"
  ],
  "lags": 4,
  "horizon": 4,
  "base_features": [
    "Group4-2_S6_VolumetricFlowRate",
    "Group4-2_S6_MassFlowRate"
  ],
  "optimize_on": "edge",
  "model_name": "lgbm_edge",
  "feature_engineering": {
    "enable": true,
    "rolling_windows": [
      2
    ],
    "stats": [
      "mean"
    ],
    "add_diff": false,
    "add_pct": false,
    "ewm_alphas": []
  },
  "search_space": {
    "n_estimators": {
      "type": "int",
      "min": 200,
      "max": 1000
    },
    "learning_rate": {
      "type": "log_float",
      "min": 0.01,
      "max": 0.2
    },
    "num_leaves": {
      "type": "int",
      "min": 16,
      "max": 64
    },
    "min_child_samples": {
      "type": "int",
      "min": 5,
      "max": 50
    },
    "subsample": {
      "type": "float",
      "min": 0.6,
      "max": 1.0
    },
    "colsample_bytree": {
      "type": "float",
      "min": 0.6,
      "max": 1.0
    },
    "reg_alpha": {
      "type": "log_float",
      "min": 1e-06,
      "max": 0.1
    },
    "reg_lambda": {
      "type": "log_float",
      "min": 0.001,
      "max": 10.0
    },
    "max_bin": {
      "type": "int",
      "min": 63,
      "max": 255
    },
    "lags": {
      "type": "int",
      "min": 1,
      "max": 8
    },
    "rolling_window_size": {
      "type": "int",
      "min": 1,
      "max": 8
    }
  }
}