{
  "loading_strategy": "split",
  "train_fraction": 0.8,
  "validation_fraction": 0.2,
  "dataset": "C:\\DEV\\RevPi_ML\\ML_Edge_Device\\Input\\Input_Data\\mqtt_data_filtered.csv",
  "target_column": "Group4-2_S6_VolumetricFlowRate",
  "exclude_columns": [
    "time",
    "datetime",
    "recording_timestamp",
    "duration"
  ],
  "lags": 4,
  "horizon": 4,
  "base_features": [
    "Group4-2_S6_VolumetricFlowRate",
    "Group4-2_S6_MassFlowRate"
  ],
  "optimize_on": "edge",
  "model_name": "cnn1d_edge",
  "feature_engineering": {
    "enable": true,
    "rolling_windows": [
      2
    ],
    "stats": [
      "mean"
    ],
    "add_diff": false,
    "add_pct": false,
    "ewm_alphas": []
  },
  "search_space": {
    "cnn_blocks": {
      "type": "int",
      "min": 1,
      "max": 2
    },
    "cnn_base_filters": {
      "type": "int",
      "min": 16,
      "max": 64
    },
    "cnn_kernel_size": {
      "type": "int",
      "min": 3,
      "max": 7
    },
    "cnn_dropout": {
      "type": "float",
      "min": 0.0,
      "max": 0.35
    },
    "cnn_activation": {
      "type": "choice",
      "choices": [
        "relu",
        "gelu"
      ]
    },
    "batch_size": {
      "type": "int_choice",
      "choices": [
        16,
        32,
        48,
        64
      ]
    },
    "epochs": {
      "type": "int",
      "min": 20,
      "max": 60
    },
    "optimizer": {
      "type": "choice",
      "choices": [
        "adam",
        "rmsprop",
        "nadam"
      ]
    },
    "learning_rate": {
      "type": "log_float",
      "min": 0.0001,
      "max": 0.005
    },
    "clipnorm": {
      "type": "float",
      "min": 0.5,
      "max": 3.0
    },
    "lags": {
      "type": "int",
      "min": 1,
      "max": 8
    },
    "rolling_window_size": {
      "type": "int",
      "min": 1,
      "max": 8
    }
  }
}